# Copy to server as /var/www/helping_api/.env and fill in values
NODE_ENV=production
PORT=3000

DB_NAME=p2p_help
DB_USER=p2phelp
DB_USER_PASS=CHANGE_ME
DB_HOST=127.0.0.1

JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=90d

SECRET_KEY=CHANGE_ME
SECRET_IV=CHANGE_ME
ECNRYPTION_METHOD=aes-256-cbc

EXPRESS_SESSION_SECRET=CHANGE_ME

API_KEY_2_FACTOR=your-2factor-key

# Public URL (no trailing slash on API_BASE_URL)
API_HOST_URL=http://YOUR_DROPLET_IP/
API_BASE_URL=http://YOUR_DROPLET_IP

# OneSignal (no spaces around =). Use REST API Key from OneSignal dashboard (starts with os_v2_app_).
# App ID must match the Android ONESIGNAL_APP_ID in user_help/admin_help MyApp.kt
ONESIGNAL_APP_ID_USER=5314c0e1-0bb2-4a55-b8b5-1de221485ef1
ONESIGNAL_API_KEY_USER=your-onesignal-rest-api-key
ONESIGNAL_API_BASE_URL=https://api.onesignal.com
